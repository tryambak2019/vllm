FROM nvidia/cuda:13.2.0-devel-ubuntu24.04

ARG BASELINE_SHA=5e51c0ca1041168de7aa9e096982aebaeebabd38
ARG CANDIDATE_SHA=2c94a97dede4fef539e9bba8ddd9e5def7d845bf

ENV CUDA_HOME=/usr/local/cuda \
    PATH=/root/.cargo/bin:/root/.local/bin:/workspace/vllm/.venv/bin:$PATH \
    TORCH_CUDA_ARCH_LIST=12.0 \
    CMAKE_BUILD_PARALLEL_LEVEL=2 \
    MAX_JOBS=2 \
    CCACHE_DISABLE=1 \
    SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0 \
    VLLM_USE_PRECOMPILED=0 \
    UV_LINK_MODE=copy

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
      build-essential curl git libnuma-dev libssl-dev pkg-config && \
    rm -rf /var/lib/apt/lists/* && \
    curl -LsSf https://astral.sh/uv/install.sh | sh && \
    curl -LsSf https://sh.rustup.rs | sh -s -- -y --profile minimal

WORKDIR /workspace/vllm
COPY . .
COPY .github/pr-67795/q_gemm.baseline.cu /opt/q_gemm.baseline.cu
COPY csrc/quantization/gptq/q_gemm.cu /opt/q_gemm.candidate.cu

RUN uv venv --python 3.12 && \
    uv pip install -r requirements/build/cuda.txt --torch-backend=cu132 && \
    uv pip install -r requirements/cuda.txt --torch-backend=cu132 && \
    .venv/bin/python -c \
      'import torch; assert torch.version.cuda == "13.2", torch.__version__'

RUN cp /opt/q_gemm.baseline.cu csrc/quantization/gptq/q_gemm.cu && \
    VLLM_USE_PRECOMPILED=1 \
    VLLM_PRECOMPILED_WHEEL_COMMIT="$BASELINE_SHA" \
    VLLM_PRECOMPILED_WHEEL_VARIANT=cu132 \
      uv pip install -e . --reinstall --no-build-isolation --no-deps

RUN .github/pr-67795/build_targeted_variants.sh

COPY .github/pr-67795/benchmark_gptq_m1.py /opt/bench/benchmark_gptq_m1.py
COPY .github/pr-67795/run_prebuilt_m1.sh /opt/bench/run_prebuilt_m1.sh

LABEL org.opencontainers.image.source="https://github.com/tryambak2019/vllm" \
      org.opencontainers.image.revision="$CANDIDATE_SHA" \
      org.opencontainers.image.description="PR 67795 sm_120 baseline/candidate benchmark image"

CMD ["bash"]
